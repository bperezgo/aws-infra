{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "dist/**",
      "node_modules/**",
      "cdk.out/**",
      "**/*.d.ts",
      "**/*.js"
    ]
  },
  "context": {
    "@aws-cdk/aws-ecs:enableExecuteCommand": true
  }
}
